<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS (launchd): ~/Library/LaunchAgents/quest.nae.gh-updater.plist
     Terminal を操作するためログインユーザーの LaunchAgent にする(LaunchDaemon は不可)。
     導入: 初回は Terminal で `gh-updater --config <設定>` を手動起動し、オートメーションを許可 → Ctrl+C
           その後 launchctl load ~/Library/LaunchAgents/quest.nae.gh-updater.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>quest.nae.gh-updater</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/USER/bin/gh-updater</string>
        <string>--config</string>
        <string>/Users/USER/.config/gh-updater/updater.mac.toml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/Users/USER/Library/Logs/gh-updater.log</string>
</dict>
</plist>
